# 2. NEXTAUTH / JWT SECURITY
# ------------------------------------------
# Generate a secure secret using: openssl rand -base64 32
NEXTAUTH_SECRET="artqala-super-secret-key-change-this-in-production"
# In local development:
NEXTAUTH_URL="http://localhost:3000"
# In production (set to your Vercel URL or custom domain):
# NEXTAUTH_URL="https://artqala.uz"

# 3. EMAIL OTP SERVICE (RESEND) [OPTIONAL]
# ------------------------------------------
# Sign up free at https://resend.com (100 emails/day free)
# If left empty, OTP codes are logged to the terminal in development.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Art Qala <auth@artqala.uz>"

# 4. CURRENCY EXCHANGE RATE API [OPTIONAL]
# ------------------------------------------
# Sign up free at https://www.exchangerate-api.com
EXCHANGE_RATE_API_KEY=""

# 5. IMAGE STORAGE (CLOUDINARY / VERCEL BLOB) [OPTIONAL]
