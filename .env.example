# ==========================================
# ART QALA — ENVIRONMENT VARIABLES
# ==========================================

# 1. DATABASE
# ------------------------------------------
# For Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# For Production (PostgreSQL - Neon, Supabase, Vercel Postgres, Railway, etc.):
# DATABASE_URL="postgresql://username:password@ep-sample-12345.eu-central-1.aws.neon.tech/artqala?sslmode=require"

# 2. NEXTAUTH / JWT SECURITY
# ------------------------------------------
# Generate a secure secret using: openssl rand -base64 32
NEXTAUTH_SECRET="artqala-super-secret-key-change-this-in-production"
# In local development:
NEXTAUTH_URL="http://localhost:3000"
# In production (set to your Vercel URL or custom domain):
# NEXTAUTH_URL="https://artqala.uz"

# 3. GOOGLE / APPLE SIGN-IN (OAUTH) [OPTIONAL]
# ------------------------------------------
# Without these, OAuth buttons fall back to an instant demo login in
# development only — real credentials are required in production, otherwise
# the buttons redirect to an error instead of logging anyone in.
#
# Google — create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
#
# Apple — create a Services ID at https://developer.apple.com/account/resources/identifiers/list/serviceId
# Return URL: <NEXTAUTH_URL>/api/auth/oauth/apple/callback
# (Only the Services ID / client_id is needed — this app verifies Apple's
# signed id_token directly and does not perform a server-side token exchange.)
APPLE_CLIENT_ID=""

# 4. EMAIL OTP SERVICE (RESEND) [OPTIONAL]
# ------------------------------------------
# Sign up free at https://resend.com (100 emails/day free)
# If left empty, OTP codes are logged to the terminal in development.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Art Qala <auth@artqala.uz>"

# 5. CURRENCY EXCHANGE RATE API [OPTIONAL]
# ------------------------------------------
# Sign up free at https://www.exchangerate-api.com
EXCHANGE_RATE_API_KEY=""

# 6. IMAGE STORAGE (CLOUDINARY / VERCEL BLOB) [OPTIONAL]
# ------------------------------------------
# For direct uploads in admin panel:
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
BLOB_READ_WRITE_TOKEN=""
